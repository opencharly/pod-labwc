#!/bin/sh
# labwc-wrapper: start labwc as a nested compositor inside pixelflux's
# wayland-1 display. labwc creates wayland-0 for its own clients (waybar, apps).

# The wait for pixelflux's wayland-1 socket is NOT here any more: it is the
# service's `wait_for:` (charly.yml), lowered by the init plugin into the
# supervised pre-exec. The hand-rolled loop this replaces also had a real bug —
# it slept 0.5s per iteration while counting ELAPSED by 1, so `TIMEOUT=30`
# actually waited 15 seconds and then reported "not ready after 30s".
#
# Supervised also means a timeout FAILS THE SERVICE and shows in its status,
# where a wrapper exiting 1 looked like labwc itself had crashed.

# labwc connects to pixelflux (wayland-1) as its parent display
export WAYLAND_DISPLAY=wayland-1
export XCURSOR_THEME=breeze_cursors
export XCURSOR_SIZE=24
export XKB_DEFAULT_LAYOUT="${XKB_DEFAULT_LAYOUT:-us}"
export XKB_DEFAULT_VARIANT="${XKB_DEFAULT_VARIANT:-}"
export XKB_DEFAULT_MODEL="${XKB_DEFAULT_MODEL:-pc105}"
export XKB_DEFAULT_OPTIONS="${XKB_DEFAULT_OPTIONS:-}"
export XKB_DEFAULT_RULES=evdev

exec labwc
